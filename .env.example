# ============================================================================
# APP GANADERA - Variables de Entorno (PLANTILLA SIN SECRETOS REALES)
# Copia este archivo a `.env.local` para desarrollo o configúralo en Vercel
# NUNCA subas `.env` ni `.env.local` con credenciales reales a Git.
# ============================================================================

# Base de datos PostgreSQL (Neon, Supabase Postgres, RDS, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/app_ganadera?sslmode=require"

# URL pública base de la aplicación (sin slash final)
APP_BASE_URL="http://localhost:3000"

# Secreto criptográfico de servidor para pepper de hashes/IP y firma auxiliar (min 32 bytes hex/base64)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SERVER_PEPPER="replace-with-64-char-hex-secret-in-production"

# Google OAuth 2.0 / OpenID Connect (Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Proveedor de Correo Transaccional (Resend)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="APP GANADERA <no-reply@tudominio.com>"

# Versión vigente de la Política de Privacidad y Tratamiento de Datos (Ley 1581/2012)
PRIVACY_POLICY_VERSION="2026-11-v1"

# Secreto para tareas programadas (Vercel Cron /api/internal/cleanup)
CRON_SECRET="replace-with-random-secret-for-vercel-cron"

# Límite opcional de conexiones por instancia serverless (usar transaction pooler en producción)
PG_POOL_MAX="2"
